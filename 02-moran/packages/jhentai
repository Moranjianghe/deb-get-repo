DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
CODENAMES_SUPPORTED="buster bullseye bookworm trixie sid focal jammy noble oracular plucky"

get_github_releases "jiangtian616/JHenTai" "latest"

if [ "${ACTION}" != prettylist ]; then
    case "${HOST_ARCH}" in
        amd64) FILE_ARCH="x64" ;;
        arm64) FILE_ARCH="arm64" ;;
        *)     FILE_ARCH="" ;;
    esac

    if [ -n "${FILE_ARCH}" ]; then
        URL=$(grep -Eim 1 "browser_download_url.*Linux-${FILE_ARCH}\\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)

        if [ -n "${URL}" ]; then
            # Keep the Debian build number included in the asset name.
            VERSION_PUBLISHED=$(basename "${URL}" | sed -nE 's/^JHenTai-([0-9]+\.[0-9]+\.[0-9]+)(%2B|\+)([0-9]+)-Linux-.*/\1+\3/p')
        fi
    fi
fi

PRETTY_NAME="JHenTai"
WEBSITE="https://github.com/jiangtian616/JHenTai"
SUMMARY="A cross-platform manga reader for nhentai."
